// ═══════════════════════════════════════════
// ChefNote Firestore Security Rules
//
// 핵심 원칙:
//   1. 본인 데이터만 읽고 쓸 수 있다 (request.auth.uid == userId)
//   2. 이메일 인증 안 된 계정은 데이터 진입 차단 (token.email_verified == true)
//   3. isPro 와 notesCreated 는 클라이언트가 자기 마음대로 못 쓴다
//      → Admin SDK (Cloud Functions) 또는 Worker 만 변경 가능
//
// 적용:
//   Firebase Console → Firestore → Rules 탭에 그대로 붙여넣기 → Publish
//   (또는 firebase deploy --only firestore:rules)
// ═══════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──
    function isSignedIn() {
      return request.auth != null;
    }
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return isEmailVerified() && request.auth.uid == uid;
    }
    // 클라이언트가 절대 못 건드릴 필드들
    function protectedUserFields() {
      return ['isPro', 'notesCreated', 'plan', 'subscription'];
    }
    function isUpdatingProtectedField() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(protectedUserFields());
    }

    // ── /users/{uid} ──
    match /users/{uid} {
      allow read: if isOwner(uid);

      // create: 본인만, 보호 필드는 기본값만 허용
      allow create: if isOwner(uid)
        && (!('isPro' in request.resource.data) || request.resource.data.isPro == false)
        && (!('notesCreated' in request.resource.data) || request.resource.data.notesCreated == 0);

      // update: 본인만, 단 보호 필드는 못 건드림
      allow update: if isOwner(uid) && !isUpdatingProtectedField();

      allow delete: if false; // 삭제는 서버 사이드로

      // ── /users/{uid}/notes/{noteId} ──
      match /notes/{noteId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/{subcol}/{doc} ── (확장 대비)
      match /{subcol}/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // 기본 거부 — 위에서 명시되지 않은 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
